# ════════════════════════════════════════════════════════════════════════════
#  Flexible Street Platform — Environment Variables (Template)
#
#  USAGE:
#    1. Copy this file to .env (which is git-ignored)
#    2. Replace each placeholder with the real value
#    3. Restart `npm run dev` so Vite reloads the variables
#
#  All variables are prefixed VITE_ so Vite exposes them to the browser.
#  This means they are PUBLIC — never put a private secret here.
#  Mapbox / Google Street View / Ticketmaster keys are designed to be
#  exposed; they should be locked down by HTTP-Referer restrictions on
#  the providers' dashboards.
# ════════════════════════════════════════════════════════════════════════════

# ── 1. Mapbox GL access token (REQUIRED) ───────────────────────────────────
# Without this, the map will not render.
# Get one at https://account.mapbox.com/access-tokens/  (free tier is enough)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── 2. Supabase project URL + anon key (REQUIRED) ──────────────────────────
# These point at the backend that hosts POI, AI scores, playstreets, events.
# Find both in Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── 3. Google Street View Static API key (OPTIONAL) ────────────────────────
# Drives the street-view photo in the StreetScorePanel detail panel.
# If omitted, the panel still works but the photo is hidden.
# Get one at https://console.cloud.google.com/  → Enable "Street View Static API"
VITE_GOOGLE_SV_KEY=your_google_sv_key_here

# ── 4. Ticketmaster Discovery API key (OPTIONAL) ───────────────────────────
# Pulls seasonal events (parades, marathons, festivals) that boost the
# Flexibility Score for nearby streets. If omitted, the events modifier
# defaults to 1.0 (no boost) and the platform still functions.
# Get one at https://developer.ticketmaster.com/
VITE_TICKETMASTER_KEY=your_ticketmaster_key_here
